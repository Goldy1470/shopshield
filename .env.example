# ── Database ────────────────────────────────────────────────────────────────
# Neon or Supabase Postgres connection string (pooled for app runtime).
DATABASE_URL=

# Separate Postgres URL used only by vitest integration tests (tests reset data).
TEST_DATABASE_URL=

# ── Encryption at rest (tokens / sensitive fields) ─────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
# Until both are set, /console shows the honest "sign-in not configured" state.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Evidence storage (S3-compatible; R2/MinIO/Supabase Storage all work) ───
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI drafting (Phase 3) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model name is config, not code (e.g. claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=
